# ==================== 构建阶段 ====================
# 精简版：只保留 V1 代理 + 定时器接口。
# 复用 pages/api/v1 与 pages/api/cron 路由本体，构建门控脚本（lite-gate.sh）在
# next build 前临时移走前端页面与其他 API 路由，使产物只含 V1 + 定时器。
FROM node:22-alpine AS builder

WORKDIR /app

# 创建非 root 用户（构建阶段也以此用户运行，避免最终 chown）
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs && \
    chown -R nextjs:nodejs /app

# lite 构建门控脚本（lite-gate.sh / lite-gate-restore.sh）用 bash 编写，Alpine 基础镜像默认无
RUN apk add --no-cache bash

# 构建方言：all=生成全部四种方言 client（d1/mysql/mariadb/pg），镜像与任意运行时
# DB_TYPE 通用（Docker 无 Worker 体积限制）；指定单一方言可缩小镜像体积，
# 但指定单一方言时构建期与运行期 DB_TYPE 必须一致，否则运行时会以错误的
# 方言 client 加载对应 adapter（provider/adapter 不匹配报错）。
ARG DB_TYPE=all
ENV DB_TYPE=$DB_TYPE

# 部署平台：构建期内联 NEXT_PUBLIC_DEPLOY_PLATFORM（前端展示/门控用），
# 必须与运行阶段一致
ENV DEPLOY_PLATFORM=docker

# 安装完整依赖（--ignore-scripts 跳过 prepare 钩子：容器内无 .git/.githooks，钩子会失败；
# Prisma Client 由 prebuild 钩子在构建时生成）
# --legacy-peer-deps：容器内无 .npmrc（本文件未复制它），strict 模式下 npm ci 的
# lockfile 校验会报 EUSAGE，必须显式传 flag（与主 Dockerfile 一致）
COPY --chown=nextjs:nodejs package.json package-lock.json ./
USER nextjs
RUN npm ci --ignore-scripts --legacy-peer-deps

# 复制源码并构建（显式 prepare-db 生成方言 client 供独立定时器打包；
# 构建环境无 CI=true，prepare-db.mjs 不会执行 db push，表结构由容器启动时同步）
COPY --chown=nextjs:nodejs . .

# 独立定时器进程：先生成 Prisma client 再打包 scheduler.cjs 与 register-device.cjs，最后 next build。
# 定时器不依赖 instrumentation——instrumentation 会把调度器链编入 Cloudflare
# Edge Worker，导致 Pages Function 体积超限，2026-08-18 已改为独立进程方案
#（docker-entrypoint.lite.sh 启动 .build/scheduler.cjs）
# .build/register-device.cjs：启动期按 NODE_NAME 注册/复用设备 UUID，仅 Docker 部署生效
RUN node scripts/prepare-db.mjs && node scripts/build-scheduler.mjs && node scripts/build-register-device.mjs && npm run build:lite

# ==================== 运行阶段 ====================
# 精简依赖清单（lite/package.json）：仅 next/react/prisma/数据库驱动，
# 无任何前端 UI 包（antd/recharts/motion 等一律不安装、不复制）。
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV ENVIRONMENT=production
# 部署平台：Docker 直连部署默认值（compose 或 docker run -e 可覆盖），
# IP 解析只信任 TCP 对端，忽略所有前置头
ENV DEPLOY_PLATFORM=docker
ENV NEXT_TELEMETRY_DISABLED=1

# wget 备用（健康检查用 node fetch，无需额外安装）

# 创建非 root 用户（与 builder 阶段相同 UID/GID）
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs && \
    chown -R nextjs:nodejs /app

# 安装精简生产依赖（含 prisma CLI，用于启动时同步表结构）
COPY --chown=nextjs:nodejs lite/package.json lite/package-lock.json ./
USER nextjs
RUN npm ci --omit=dev --ignore-scripts --legacy-peer-deps

# 复制构建产物（仅 v1 + cron 路由）与运行所需文件（带所有权，避免最终 chown）
COPY --chown=nextjs:nodejs --from=builder /app/.next ./.next
COPY --chown=nextjs:nodejs --from=builder /app/prisma ./prisma
COPY --chown=nextjs:nodejs --from=builder /app/prisma.config.ts ./
COPY --chown=nextjs:nodejs --from=builder /app/scripts ./scripts/

# 独立定时器进程产物（docker-entrypoint.lite.sh 后台启动，含内联 Prisma client 与 wasm 编译器）
COPY --chown=nextjs:nodejs --from=builder /app/.build ./.build

# 启动脚本（启动时同步表结构 + 启动独立定时器进程）
COPY --chown=nextjs:nodejs docker-entrypoint.lite.sh ./
RUN chmod +x docker-entrypoint.lite.sh

EXPOSE 3000

USER nextjs

ENV PORT=3000

# 健康检查：lite 无页面，探测 v1 路由（未认证 401 / 正常 200 均视为存活）
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://localhost:${PORT}/api/v1/models').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["./docker-entrypoint.lite.sh"]
