{
  "name": "fiammetta-watcher",
  "version": "3.1.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/dev-postgres.mjs --ensure && node scripts/prepare-db.mjs",
    "db:dev": "node scripts/dev-postgres.mjs",
    "prebuild": "node scripts/prepare-db.mjs",
    "build": "next build",
    "prebuild:lite": "node scripts/prepare-db.mjs",
    "build:lite": "bash scripts/lite-gate.sh && next build && bash scripts/lite-gate-restore.sh",
    "build:cf": "export DEPLOY_PLATFORM=cf && bash scripts/build-gate.sh && node scripts/prepare-db.mjs && opennextjs-cloudflare build && mv .open-next/worker.js .open-next/_worker.js && cp -r .open-next/assets/* .open-next/ && cp public/_headers .open-next/_headers && node -e \"require('fs').writeFileSync('.open-next/_routes.json', JSON.stringify({version:1,include:['/*'],exclude:['/_next/static/*','/favicon.ico','/robots.txt','/sitemap.xml','/BUILD_ID']},null,2))\" && bash scripts/build-gate-restore.sh",
    "preview": "DEPLOY_PLATFORM=cf opennextjs-cloudflare build && DEPLOY_PLATFORM=cf opennextjs-cloudflare preview",
    "deploy": "npm run build:cf && wrangler pages deploy .open-next --project-name fiammetta-watcher --branch main",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:gen": "DATABASE_URL=\"file:./placeholder.db\" npx prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script > init.sql",
    "db:local": "npx wrangler d1 execute fiammetta_d1 --file=init.sql --local",
    "db:remote": "npx wrangler d1 execute fiammetta_d1 --file=init.sql --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks && node scripts/prepare-db.mjs"
  },
  "dependencies": {
    "@lobehub/icons": "^5.16.0",
    "@prisma/adapter-d1": "^7.9.0",
    "@prisma/adapter-mariadb": "7.9.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tidbcloud/prisma-adapter": "^6.17.0",
    "@tidbcloud/serverless": "^0.3.0",
    "antd": "^6.5.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fetch-socks": "^1.3.3",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jose": "^6.2.4",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "prisma": "^7.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.10",
    "recharts": "^3.10.0",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "undici": "^7.29.0"
  },
  "optionalDependencies": {
    "mariadb": "^3.4.5",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dayjs": "^1.11.21",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "cloudflare": "4.4.1",
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    },
    "vitepress": {
      "vite": "6.4.3"
    },
    "deepmerge-ts": "^8.0.0"
  }
}
