// ================================================================
// Fiammetta Watcher Proxy — Prisma Schema (D1 / SQLite 方言)
// 生成客户端输出到 src/generated/d1
// ================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/d1"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
  // url 由 prisma.config.ts 提供
}

// ==================== 管理员账户 ====================

model admins {
  id           String @id
  username     String @unique
  passwordHash String @map("password_hash")
  createdAt    Int    @default(0) @map("created_at")
  updatedAt    Int    @default(0) @map("updated_at")

  @@map("admins")
}

// ==================== 上游平台 ====================

model platforms {
  id             String  @id
  name           String
  baseUrl        String  @map("base_url")
  apiKeys        String  @map("api_keys")
  type           String  @default("openai")
  // 预设来源（从预设模板创建时记录，用于图标与来源识别）
  presetId       String? @map("preset_id")
  enabled        Boolean @default(true)
  priority       Int     @default(0)
  weight         Int     @default(1)
  rpmLimit       Int?    @map("rpm_limit")
  tpmLimit       Int?    @map("tpm_limit")
  status         String  @default("healthy")
  failCount      Int     @default(0) @map("fail_count")
  lastFailAt     Int?    @map("last_fail_at")
  cooldownEnd    Int?    @map("cooldown_end")
  forwardHeaders String  @map("forward_headers")
  injectStreamOptions Boolean @default(true) @map("inject_stream_options")
  whitelisted    Boolean @default(false) @map("whitelisted")
  // 高级设置：UA 复用
  reuseUserAgent Boolean @default(false) @map("reuse_user_agent")
  customUserAgent String? @map("custom_user_agent")
  // 高级设置：自定义请求头（强制覆盖，JSON 键值对字符串）
  extraHeaders  String  @default("{}") @map("extra_headers")
  createdAt      Int     @default(0) @map("created_at")
  updatedAt      Int     @default(0) @map("updated_at")

  @@index([enabled, status])
  @@map("platforms")
}

// ==================== API 密钥 ====================

model apiKeys {
  id              String   @id
  key             String   @unique
  name            String
  usedTokens      BigInt   @default(0) @map("used_tokens")
  tokenLimit      Int?     @map("token_limit")
  rpmLimit        Int?     @map("rpm_limit")
  tpmLimit        Int?     @map("tpm_limit")
  callLimit       Int?     @map("call_limit")
  callUsed        Int      @default(0) @map("call_used")
  resetPeriod     String?  @default("monthly") @map("reset_period")
  // 允许调用的客户端 IP 白名单（CIDR 列表，JSON 字符串，空/null=不限制）
  allowedIps      String?  @map("allowed_ips")
  // 允许调用的模型白名单（模型 ID 列表，JSON 字符串，空/null=不限制）
  allowedModels   String?  @map("allowed_models")
  status          String   @default("active")
  expiresAt       Int?     @map("expires_at")
  createdAt       Int      @default(0) @map("created_at")
  updatedAt       Int      @default(0) @map("updated_at")

  @@index([key])
  @@index([status, expiresAt])
  @@map("api_keys")
}

// ==================== 系统 API 密钥 ====================

model systemApiKeys {
  id         String  @id
  key        String  @unique
  name       String
  enabled    Boolean @default(true)
  lastUsedAt Int?    @map("last_used_at")
  createdAt  Int     @default(0) @map("created_at")
  updatedAt  Int     @default(0) @map("updated_at")

  @@index([key])
  @@map("system_api_keys")
}

// ==================== 平台模型（自动发现） ====================

model platformModels {
  id         String  @id
  platformId String  @map("platform_id")
  modelId    String  @map("model_id")
  ownedBy    String? @map("owned_by")
  modelName  String? @map("model_name")
  type       String  @default("chat")
  source     String  @default("auto")
  enabled    Boolean @default(true)
  fetchedAt  Int     @default(0) @map("fetched_at")

  @@unique([platformId, modelId])
  @@index([platformId])
  @@index([modelId])
  @@map("platform_models")
}

// ==================== 请求日志 ====================

model requestLogs {
  id               String  @id
  keyId            String? @map("key_id")
  keyName          String? @map("key_name")
  platformId       String? @map("platform_id")
  model            String
  endpoint         String?
  method           String?
  status           Int
  latency          Int     @default(0)
  tokens           Int     @default(0)
  promptTokens     Int     @default(0) @map("prompt_tokens")
  completionTokens Int     @default(0) @map("completion_tokens")
  ttft             Int     @default(0)
  cost             Float   @default(0)
  isError          Boolean @default(false) @map("is_error")
  ipAddress        String? @map("ip_address")
  userAgent        String? @map("user_agent")
  nodeName         String? @map("node_name")
  errorMessage     String? @map("error_message")
  proxyUrl         String? @map("proxy_url")
  hasReasoning     Boolean @default(false) @map("has_reasoning")
  createdAt        Int     @default(0) @map("created_at")

  @@index([createdAt])
  @@index([keyId, createdAt])
  @@index([platformId, createdAt])
  @@index([proxyUrl, createdAt])
  @@map("request_logs")
}

// ==================== 每日统计 ====================

model dailyStats {
  id                    String  @id
  date                  Int
  keyId                 String? @map("key_id")
  keyName               String? @map("key_name")
  platformId            String? @map("platform_id")
  platformName          String? @map("platform_name")
  model                 String
  totalRequests         Int     @default(0) @map("total_requests")
  errorRequests         Int     @default(0) @map("error_requests")
  totalTokens           Int     @default(0) @map("total_tokens")
  totalPromptTokens     Int     @default(0) @map("total_prompt_tokens")
  totalCompletionTokens Int     @default(0) @map("total_completion_tokens")
  totalCost             Float   @default(0) @map("total_cost")
  avgTtft               Float   @default(0) @map("avg_ttft")
  avgDuration           Float   @default(0) @map("avg_duration")
  avgTps                Float   @default(0) @map("avg_tps")
  maxTtft               Int    @default(0) @map("max_ttft")
  maxDuration           Int     @default(0) @map("max_duration")
  maxTps                Float   @default(0) @map("max_tps")
  createdAt             Int     @default(0) @map("created_at")

  @@unique([date, keyId, model])
  @@index([date])
  @@index([keyId, date])
  @@index([platformId, date])
  @@map("daily_stats")
}

// ==================== 系统配置 ====================

model configs {
  id        String @id
  key       String @unique
  value     String
  updatedAt Int    @default(0) @map("updated_at")

  @@map("configs")
}

// ==================== 审计日志 ====================

model auditLogs {
  id        String  @id
  adminId   String? @map("admin_id")
  action    String
  detail    String?
  ip        String?
  createdAt Int     @default(0) @map("created_at")

  @@index([adminId])
  @@index([createdAt])
  // 登录限流"先写后查"与预检按 action+ip+createdAt 查询，复合索引避免全表扫描
  @@index([action, ip, createdAt])
  @@map("audit_logs")
}

// ==================== 通知系统（v2 持久化去重 + 发送历史） ====================

// 事件冷却去重（替换原进程内 lastSentAt Map，多实例一致）
model notificationCooldowns {
  id        String @id
  eventKey  String @unique @map("event_key")
  lastSentAt Int   @default(0) @map("last_sent_at")
  updatedAt Int    @default(0) @map("updated_at")

  @@map("notification_cooldowns")
}

// Key 用量配额一次性提醒（80/95/100 档位分别记录，重启/多实例不重发）
model quotaNotified {
  id        String @id
  keyId     String @map("key_id")
  threshold Int    @map("threshold")
  notifiedAt Int   @default(0) @map("notified_at")

  @@unique([keyId, threshold])
  @@index([keyId])
  @@map("quota_notified")
}

// 通知 / 备份发送历史（管理后台"发送历史"页数据源；保留 N 天由 cron 清理）
model notificationHistory {
  id         String  @id
  channelId  String  @map("channel_id")
  channelName String @map("channel_name")
  channelType String @map("channel_type")
  event      String
  title      String
  body       String
  status     String
  httpStatus Int?    @map("http_status")
  error      String?
  sizeBytes  Int     @default(0) @map("size_bytes")
  durationMs Int     @default(0) @map("duration_ms")
  sentAt     Int     @default(0) @map("sent_at")

  @@index([sentAt])
  @@index([channelId, sentAt])
  @@index([event, sentAt])
  @@map("notification_history")
}

// ==================== 设备注册（启动时按 NODE_NAME 注册/复用 UUID）================
//
// 用途：每次服务实例启动时，根据环境变量 NODE_NAME（或回退部署平台名）查表：
//   - 命中则复用该记录的 UUID（重启后设备档案稳定）
//   - 未命中则插入新行（设备名 + 新 UUID + 平台名 + 首次注册时间）
//
// 部署矩阵：
//   - Docker / Docker-lite：容器启动时 entrypoint 调用一次
//   - EdgeOne / Vercel / 本地开发：不在启动期调用；管理后台可见空表
//   - Cloudflare：CF stub alias 让业务层零访问，物理表存在但不读写
model deviceRegistrations {
  id          String   @id
  // 设备名（清洗后的 NODE_NAME 或部署平台回退名；按此唯一索引做幂等查重）
  deviceName  String   @unique @map("device_name")
  // 设备 UUID：首次注册时生成，重启按 device_name 复用
  uuid        String   @unique
  // 来源平台（edgeone/vercel/docker/cf/local），便于管理后台按平台筛选
  platform    String
  // 设备 IP 标识：Docker/EdgeOne 部署可取到容器/源站 IP；CF Workers 取 clientIP；本地开发为 local
  address     String?
  // 部署版本（package.json version），便于追踪运行实例版本
  appVersion  String?  @map("app_version")
  // 首次注册时间（Unix 秒）
  firstSeenAt Int      @default(0) @map("first_seen_at")
  // 最近一次启动时间（Unix 秒；每次启动更新为 now）
  lastSeenAt  Int      @default(0) @map("last_seen_at")
  // 启动次数（命中既有记录累加）
  bootCount   Int      @default(0) @map("boot_count")
  createdAt   Int      @default(0) @map("created_at")
  updatedAt   Int      @default(0) @map("updated_at")

  @@index([platform])
  @@index([lastSeenAt])
  @@map("device_registrations")
}
