{
  // 不声明 pages_build_output_dir：8-21 成功部署时该字段不存在（wrangler 4.122.0
  // 走兼容路径，能处理 6 MB+ 的 handler.mjs 不触发 3 MiB 单 module 限制）。
  // 加 pages_build_output_dir 后 wrangler 走 Pages Advanced Mode 严格 3 MiB 检查，
  // OpenNext 1.20.2 产出的 handler.mjs ~6.5-7 MB 会超限。
  "name": "fiammetta",
  "compatibility_date": "2025-04-02",
  "compatibility_flags": ["nodejs_compat"],
  // vars 由 deploy/init.py post-deploy 通过 Cloudflare API 设置
  // wrangler pages deploy 会用 wrangler.jsonc 的 vars 覆盖 API 设置值，故此处不能放 vars
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fiammetta_d1",
      "database_id": "placeholder-d1-id"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "placeholder-kv-id"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "placeholder-hyperdrive-id"
    }
  ]
}
