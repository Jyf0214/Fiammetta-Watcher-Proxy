{
  // Pages 项目（4.122+）不允许声明 main / assets 键（与 pages_build_output_dir 互斥）；
  // build:cf 已将产物重命名为 _worker.js 并把静态资源提升到 .open-next 根目录，
  // Pages 会从 pages_build_output_dir 指向的目录自动识别入口与静态资源。
  "pages_build_output_dir": ".open-next",
  "name": "fiammetta",
  "compatibility_date": "2025-04-02",
  "compatibility_flags": ["nodejs_compat"],
  // vars 由 deploy/init.py post-deploy 通过 Cloudflare API 设置
  // wrangler pages deploy 会用 wrangler.jsonc 的 vars 覆盖 API 设置值，故此处不能放 vars
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fiammetta_d1",
      "database_id": "placeholder-d1-id"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "placeholder-kv-id"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "placeholder-hyperdrive-id"
    }
  ]
}
